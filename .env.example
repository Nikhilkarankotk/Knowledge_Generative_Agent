# ---- Application ----
APP_NAME=Users
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ---- Database (matches src/main/resources/application.yml) ----
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5433
DB_NAME=Knowledge_Gen_Agent
DB_USER=postgres
DB_PASSWORD=postgres
# Optional full override (takes precedence over the individual DB_* variables):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/Knowledge_Gen_Agent
# Set to true to echo SQL (mirrors spring.jpa.show-sql: true)
DB_ECHO_SQL=false

# ---- Mistral AI (the Java app reads MISTRAL_API_KEY from the environment) ----
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_TIMEOUT_SECONDS=30
MISTRAL_RETRIES=3

# ---- RAG ----
RAG_CHUNK_SIZE=500
RAG_TOP_K=5

# ---- Conversation memory ----
CONVERSATION_MAX_HISTORY=10

# ---- CORS (JSON array; pydantic-settings requires list fields as JSON in dotenv) ----
CORS_ORIGINS=["http://localhost:4200"]