# ---- Application ----
APP_NAME=Users
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ---- Database (matches src/main/resources/application.yml) ----
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5433
DB_NAME=Knowledge_Gen_Agent
DB_USER=postgres
DB_PASSWORD=postgres
# Optional full override (takes precedence over the individual DB_* variables):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/Knowledge_Gen_Agent
# Set to true to echo SQL (mirrors spring.jpa.show-sql: true)
DB_ECHO_SQL=false

# ---- Mistral AI (the Java app reads MISTRAL_API_KEY from the environment) ----
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_TIMEOUT_SECONDS=30
MISTRAL_RETRIES=3

# ---- RAG ----
RAG_CHUNK_SIZE=500
RAG_TOP_K=5

# ---- Conversation memory ----
CONVERSATION_MAX_HISTORY=10

# ---- Knowledge Generative Agent (Semantic Kernel, Phase 1) ----
# Routes chat through the Semantic Kernel KnowledgeGenerativeAgent
# (KnowledgePlugin -> RAG, ConfluencePlugin -> Confluence). Set to false to use
# the original augmented-prompt path only.
SK_AGENT_ENABLED=true
# Max auto-invocation rounds Semantic Kernel may perform per turn.
SK_MAX_AUTO_INVOKE_ATTEMPTS=10
# Per-turn timeout for the agent (tools + final completion) in seconds.
# Raise if retrieval-heavy questions with many allowlisted GitHub repositories
# exhaust the budget (the agent then falls back to the legacy ChatService path).
SK_AGENT_TIMEOUT_SECONDS=120

# ---- Confluence (ConfluencePlugin, Phase 1) ----
CONFLUENCE_ENABLED=false
CONFLUENCE_BASE_URL=
# Use a Confluence API token (PAT). If CONFLUENCE_USERNAME is also set, the
# request authenticates with HTTP Basic (username:token); otherwise Bearer token.
CONFLUENCE_API_TOKEN=
CONFLUENCE_USERNAME=
CONFLUENCE_LIMIT=5
CONFLUENCE_TIMEOUT_SECONDS=15
CONFLUENCE_PAGE_CHAR_LIMIT=15000

# ---- GitHub (GitHubPlugin, Phase 2) ----
# Read-only knowledge integration. Use a personal access token with only read
# scopes (e.g. fine-grained PAT restricted to the repositories the agent needs).
GITHUB_ENABLED=false
GITHUB_TOKEN=
# For GitHub Enterprise, point at the API root, e.g. https://github.example.com/api/v3
GITHUB_BASE_URL=https://api.github.com
# Comma-separated allowlist of repositories (owner/repo) the agent may read, e.g.
# GITHUB_ALLOWED_REPOSITORIES=owner/repo1,owner/repo2
# Names must match GitHub exactly (case-insensitive, but punctuation/underscores
# matter). Private repositories require the token to have access to them.
# Only these repositories are accessible; global repository/code search is disabled
# and any other repository is rejected before an API call. Leave empty to disable
# GitHub repository access entirely (the agent answers "No GitHub repositories are
# configured for this Knowledge Generative Agent").
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_LIMIT=5
GITHUB_TIMEOUT_SECONDS=15
GITHUB_REPO_CHAR_LIMIT=10000

# ---- GitHub report analysis LLM (optional separate provider) ----
# The GitHub repository analysis report can use a SEPARATE LLM via OpenRouter while
# chat/RAG/embeddings keep using Mistral. Set GITHUB_LLM_PROVIDER=openrouter and
# provide OPENROUTER_API_KEY to enable; leave empty (or set to "mistral") to keep
# the default Mistral synthesis client.
GITHUB_LLM_PROVIDER=
GITHUB_LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_RETRIES=2
# Bounds for the repository analysis that feeds the report narrative.
# Analysis is a deep, asynchronous operation: breadth over latency. This is a
# high safety ceiling; the source byte budget governs how much is read.
GITHUB_ANALYSIS_MAX_FILES=300
GITHUB_ANALYSIS_MAX_CONTEXT_CHARS=60000
GITHUB_ANALYSIS_MAX_TOKENS=3000
GITHUB_ANALYSIS_TEMPERATURE=0.1

# ---- SharePoint Online (SharePointPlugin, Phase 3) ----
# Read-only knowledge integration via Microsoft Graph application permissions.
# Scoped (default): uses Sites.Selected application permission; the application
# registration must have Sites.Selected (or the broad read permission below) with
# admin consent, and each target site must grant the application a read role.
# Runtime uses Sites.Selected only - never Sites.FullControl.All.
SHAREPOINT_ENABLED=false
# Tenant-wide mode: when true, the site/folder allowlists below are NOT enforced
# and the agent may search and read every SharePoint site and document the
# application's Microsoft Graph permission can access. Scoped allowlist fields
# (hostname, relative path, allowed sites/folders) become optional. This requires
# the Entra application to hold the broad read permission (e.g. Sites.Read.All or
# Files.Read.All) because the Microsoft Graph Search JSON API (and GET /sites) is
# not authorized under Sites.Selected alone. Grant with admin consent.
# SHAREPOINT_TENANT_WIDE=false
# Azure region of the Microsoft 365 tenant, REQUIRED in tenant-wide mode. The
# Microsoft Graph Search API rejects application-permission requests without it
# (HTTP 400 "Region is required when request with application permission"). Set
# it to your tenant's home region code (e.g. "IND", "US", "EUR", "APAC").
# SHAREPOINT_SEARCH_REGION=
# Microsoft Entra tenant ID.
SHAREPOINT_TENANT_ID=
# Entra application (client) ID.
SHAREPOINT_CLIENT_ID=
# Entra client secret. Do NOT commit this value to version control.
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# The targeted SharePoint site is resolved at runtime (never hard-coded) with the
# documented Graph form: GET /sites/{hostname}:/{relative-path}. Example:
# SHAREPOINT_SITE_HOSTNAME=knowledgegenagent.sharepoint.com
# SHAREPOINT_SITE_RELATIVE_PATH=/sites/KnowledgeGenAgent
SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_RELATIVE_PATH=
# Semicolon-separated allowlist of SharePoint site IDs the agent may access, each
# in Graph site-id form: "hostname,sharepointSiteGuid,webGuid". Resolve the real
# site id first, e.g.
#   GET https://graph.microsoft.com/v1.0/sites/knowledgegenagent.sharepoint.com:/sites/KnowledgeGenAgent
# and put the returned "id" here. Semicolons separate entries (commas are part of
# a site id). Only this site is accessible; no tenant-wide site discovery or search
# is used. Leave empty (together with SHAREPOINT_ENABLED=false) to disable
# SharePoint access entirely.
SHAREPOINT_ALLOWED_SITES=
# Semicolon-separated allowlist of knowledge-base folders (relative to the site's
# primary document library / Shared Documents root) the agent may list, search and
# read. This is an APPLICATION-LEVEL restriction on top of Sites.Selected: retrieval
# never leaves these folders. Example:
#   SHAREPOINT_ALLOWED_FOLDERS=sharepoint-rag-knowledge-base
# Do not put folder names into Sites.Selected - Sites.Selected operates at the
# SharePoint SITE level only.
SHAREPOINT_ALLOWED_FOLDERS=
SHAREPOINT_LIMIT=10
SHAREPOINT_TIMEOUT_SECONDS=30
SHAREPOINT_CONTENT_CHAR_LIMIT=20000

# ---- CORS (JSON array; pydantic-settings requires list fields as JSON in dotenv) ----
CORS_ORIGINS=["http://localhost:4200"]