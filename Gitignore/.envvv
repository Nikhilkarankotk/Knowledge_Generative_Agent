# ---- SharePoint Online (SharePointPlugin, Phase 3) ----
SHAREPOINT_ENABLED=true
# Tenant-wide mode is ON: the agent may search and read every SharePoint site and
# document the application's Microsoft Graph permission can access (requires the
# Entra app to hold Sites.Read.All / Files.Read.All with admin consent for the
# Microsoft Graph Search JSON API; Sites.Selected alone does not authorize it).
# Scoped fields (site hostname/path + allowlists) are kept below but not enforced.
SHAREPOINT_TENANT_WIDE=true
SHAREPOINT_SEARCH_REGION=IND
SHAREPOINT_TENANT_ID=0b2de440-83b5-4559-a88f-b1c14a4a85d1
SHAREPOINT_CLIENT_ID=03bb5f3c-f0ae-4903-88ef-fe7179d1d2fd
SHAREPOINT_CLIENT_SECRET=dkg8Q~p6rFOXA2al1EJnQQuoEwA4oHtKSYfdiaE0
SHAREPOINT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
SHAREPOINT_ALLOWED_SITES=knowledgegenagent.sharepoint.com,438af0af-fed2-4470-9ac8-7216f61117c9,25126283-31b9-43ca-8dfa-c9168ad08501
SHAREPOINT_SITE_HOSTNAME=knowledgegenagent.sharepoint.com
SHAREPOINT_SITE_RELATIVE_PATH=/sites/KnowledgeGenAgent
SHAREPOINT_ALLOWED_FOLDERS=sharepoint-rag-knowledge-base
SHAREPOINT_LIMIT=10
SHAREPOINT_TIMEOUT_SECONDS=30
SHAREPOINT_CONTENT_CHAR_LIMIT=20000
